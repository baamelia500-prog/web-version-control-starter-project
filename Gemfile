# Lets you run the site on your own computer the same way GitHub Pages builds
# it. Install with "bundle install", then preview with:
#
#   bundle exec jekyll serve
#
# and open http://localhost:4000 in a browser.
source "https://rubygems.org"

# This one gem pins Jekyll and its plugins to the exact versions GitHub Pages
# runs, so the local preview matches the published site.
gem "github-pages", group: :jekyll_plugins

# Windows and JRuby do not ship the zoneinfo files that Jekyll needs.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
